C LEASE-enter-load
(* Control for LEASE-enter-rmw: the waiter reads the count with a plain acquire load.
   x = the count of running holders (active_submit, active_operations).
   y = the lease state: 0 = OPEN, 1 = closing (REVOKING, CLOSING).
   P0 is a holder (a submit, a native call); P1 is the waiter (revoke, close).
   Bad outcome: the holder sees OPEN, and the waiter sees nobody inside.
   Expected: Sometimes. *)
{}
P0 (atomic_int* x, atomic_int* y) {
  atomic_fetch_add_explicit(x, 1, memory_order_acq_rel);
  int r0 = atomic_load_explicit(y, memory_order_acquire);
}
P1 (atomic_int* x, atomic_int* y) {
  int r1 = atomic_exchange_explicit(y, 1, memory_order_acq_rel);
  int r2 = atomic_load_explicit(x, memory_order_acquire);
}
exists (0:r0=0 /\ 1:r2=0)
