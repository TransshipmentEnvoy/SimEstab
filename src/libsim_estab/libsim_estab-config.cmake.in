@PACKAGE_INIT@

# Minimum CMake version check for C++20 modules support
cmake_minimum_required(VERSION 3.28)

# Only include targets once
if(TARGET libsim_estab::sim_estab)
    return()
endif()

# CMake module path setup
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

# Use CMakeFindDependencyMacro for proper dependency finding
include(CMakeFindDependencyMacro)

# Find required PUBLIC dependencies
# These are exposed in the library's public interface and must be found

# Boost - PUBLIC dependency with required components
find_dependency(Boost REQUIRED COMPONENTS headers filesystem nowide log)

# fmt - PUBLIC dependency for formatting
find_dependency(fmt REQUIRED)

# rang - PUBLIC dependency for terminal colors
find_dependency(rang REQUIRED)

# range-v3 - PUBLIC dependency for ranges
find_dependency(range-v3 REQUIRED)

# tsl-robin-map - PUBLIC dependency for hash map
find_dependency(tsl-robin-map REQUIRED)

# Eigen3 - PUBLIC dependency (header-only, version 5)
find_dependency(Eigen3 5 REQUIRED NO_MODULE)

# CGAL - PUBLIC dependency for computational geometry
find_dependency(CGAL REQUIRED)

# Find PRIVATE dependencies
# These are needed for the library implementation but not exposed

# SDL3 - PRIVATE dependency for graphics
find_package(SDL3 3.2 CONFIG COMPONENTS GPU)
if(NOT SDL3_FOUND)
    set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
        "SDL3 3.2 with GPU component is required but not found")
    set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
    return()
endif()

# Vulkan - PRIVATE dependency for graphics API
find_package(Vulkan REQUIRED)
if(NOT Vulkan_FOUND)
    set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
        "Vulkan is required but not found")
    set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
    return()
endif()

# Include the exported targets file
# This file is auto-generated by install(EXPORT ...) and contains the actual target definitions
include("${CMAKE_CURRENT_LIST_DIR}/libsim_estab-targets.cmake")

# Verify that all required components were found
check_required_components(libsim_estab)
